{
  "configVersion": "v3",
  "app": {
    "appId": 1128597,
    "appName": "PlantPal",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "Nils Flaschel",
    "description": "Grow a pixel plant that changes form with how you care for it"
  },
  "permissions": [
    "device:os.local_storage",
    "data:user.hd.step",
    "device:os.alarm",
    "device:os.bg_service"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/home/index",
            "page/stats/index"
          ]
        },
        "app-service": {
          "services": [
            "app-service/nightly"
          ]
        }
      },
      "platforms": [
        {
          "st": "s",
          "dw": 390
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "PlantPal"
    }
  },
  "defaultLanguage": "en-US"
}
